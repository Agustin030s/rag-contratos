# Copia este archivo a .env y completa tu clave. Nunca subas .env a git.

# Única API key del proyecto: Claude (Anthropic) redacta las respuestas.
ANTHROPIC_API_KEY=

# Verifica los nombres de modelo vigentes en la documentación oficial:
#   https://docs.anthropic.com/en/docs/about-claude/models
LLM_MODEL=claude-sonnet-5-5

# Límite de tokens de la respuesta
LLM_MAX_TOKENS=16000

# Embeddings locales (sentence-transformers, sin API key). Se descarga la
# primera vez. Si lo cambias, vuelve a indexar: python ingest.py --reindex
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# Fragmentos recuperados por consulta (recomendado: entre 3 y 5)
TOP_K=4

# Umbral de abstención: fragmentos con distancia mayor se descartan; si no queda
# ninguno, se responde "No lo sé" sin llamar al LLM. Calibrado para multilingual-e5-small.
UMBRAL_DISTANCIA=0.18
